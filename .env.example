# Template per .env locale — copiare in .env (già in .gitignore) e valorizzare.
# Nessun valore reale deve mai finire in questo file: è committato in git.

HangFireOptions__ConnectionString=Data Source=<host>;Initial Catalog=<db>;Persist Security Info=True;User ID=<user>;Password=<password>;Encrypt=False;TrustServerCertificate=True;
HangFireOptions__OpenAI__ApiKey=<api-key>
HangFireOptions__OpenAI__EmbeddingModelId=nomic-embed-text
HangFireOptions__OpenAI__EmbeddingEndpoint=http://host.docker.internal:11434/v1/
HangFireOptions__OpenAI__GenerateContentModelId=gpt-4o-mini
HangFireOptions__OpenAI__GenerateContentEndpoint=https://models.inference.ai.azure.com
HangFireOptions__OpenAI__EmbeddingDimension=768
HangFireOptions__Telegram__BotChatId=<telegram-chat-id>
HangFireOptions__Telegram__BotToken=<telegram-bot-token>

RedisCacheOptions__Host=flow-scheduler-redis
RedisCacheOptions__Port=6379
RedisCacheOptions__Password=<redis-password>
RedisCacheOptions__ConnectTimeout=30000
RedisCacheOptions__SyncTimeout=20000

GITHUB_TOKEN=<github-pat>
# GitHubOptions.Values[] — indice 0 = IsibetPro, indice 1 = Betfair (vedi Name/Owner in appsettings.json)
GitHubOptions__Values__0__Token=<github-pat-isibetpro>
GitHubOptions__Values__1__Token=<github-pat-betfair>

HealthMonitorOptions__TelegramChatId=<telegram-chat-id>

# LoggerHelper Telegram sink (BackgroundJobs + WebApi appsettings.LoggerHelper.json)
LoggerHelper__Sinks__Telegram__chatId=<telegram-chat-id>
LoggerHelper__Sinks__Telegram__Api_Key=<telegram-bot-api-key>
