<Project Sdk="Microsoft.NET.Sdk.Web">

		<PropertyGroup>
				<TargetFramework>net10.0</TargetFramework>
				<Nullable>enable</Nullable>
				<ImplicitUsings>enable</ImplicitUsings>
				<GenerateDocumentationFile>true</GenerateDocumentationFile>
				<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
				<Version>1.0.2</Version>
				<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		</PropertyGroup>
		<ItemGroup>
				<PackageReference Include="CSharpEssentials.HttpHelper" Version="5.0.8" />
				<PackageReference Include="CSharpEssentials.LoggerHelper" Version="5.0.8" />
				<PackageReference Include="CSharpEssentials.LoggerHelper.Sink.Console" Version="5.0.8" />
				<PackageReference Include="CSharpEssentials.LoggerHelper.Sink.HangfireConsole" Version="5.0.8" />
				<PackageReference Include="Hangfire" Version="1.8.23" />
				<PackageReference Include="Hangfire.Console" Version="1.4.3" />
				<PackageReference Include="Hangfire.Redis.StackExchange" Version="1.12.0" />
				<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
				<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
				<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
				<PackageReference Include="Scrutor" Version="7.0.0" />
				<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
		</ItemGroup>
		<ItemGroup>
				<ProjectReference Include="..\FlowScheduler.Infrastructure\FlowScheduler.Infrastructure.csproj" />
		</ItemGroup>

		<ItemGroup>
				<Content Update="appsettings.LoggerHelper.json">
						<CopyToOutputDirectory>Always</CopyToOutputDirectory>
						<CopyToPublishDirectory>Always</CopyToPublishDirectory>
				</Content>
				<Content Update="appsettings.LoggerHelper.debug.json">
						<CopyToOutputDirectory>Always</CopyToOutputDirectory>
						<CopyToPublishDirectory>Always</CopyToPublishDirectory>
				</Content>
		</ItemGroup>

		<ItemGroup>
		  <Folder Include="Docs\" />
		</ItemGroup>

</Project>
