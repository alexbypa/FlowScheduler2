{
  "LoggerHelper": {
    "ApplicationName": "FlowWorker",
    "Routes": [
      { "Sink": "Console", "Levels": ["Information", "Warning", "Error", "Fatal"] },
      { "Sink": "HangfireConsole", "Levels": ["Information", "Warning", "Error", "Fatal"] },
      { "Sink": "File", "Levels": ["Information", "Warning", "Error", "Fatal"] },
      { "Sink": "Telegram", "Levels": ["Error", "Fatal"] }
    ],
    "Sinks": {
      "File": {
        "Path": "/app/logs",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 7,
        "Shared": true
      },
      "Telegram": {
        "chatId": "",
        "Api_Key": "",
        "ThrottleInterval": "00:00:25"
      }
    }
  }
}
